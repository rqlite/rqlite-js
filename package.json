{
  "name": "rqlite-js",
  "version": "2.5.7",
  "description": "A client library for RQLite written in Javascript that works in NodeJS or the browser.",
  "main": "lib/index.js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "babel es6 --out-dir lib --source-maps --ignore es6/**/*.unit.js,es6/**/*.integration.js,es6/test",
    "build-all": "babel es6 --out-dir lib --source-maps",
    "build-clean": "rm -rf lib",
    "build-release": "npm run build && npm run test-build",
    "docker-build": "docker compose -p rqlitejs build",
    "docker-down": "docker compose -p rqlitejs down",
    "docker-logs": "docker compose -p rqlitejs logs",
    "docker-run-test": "docker compose -p rqlitejs run --rm test",
    "docker-stop": "docker compose -p rqlitejs stop",
    "lint": "eslint es6/**/*.js",
    "type-check": "tsc -p jsconfig.json --noEmit",
    "verify": "npm run lint && npm run type-check && npm test && npm run build-all && npm run test-build",
    "verify:integrations": "npm run docker-build && npm run docker-run-test",
    "release": "npm run verify",
    "test": "mocha --require @babel/register es6/test/unit/index.unit.js es6/**/*.unit.js",
    "test-integrations": "mocha --require @babel/register --timeout 10000 es6/**/*.integration.js",
    "test-build": "mocha lib/test/unit/index.unit.js lib/**/*.unit.js",
    "test-build-integrations": "mocha --timeout 30000 lib/**/*.integration.js",
    "prepublishOnly": "npm run lint && npm run type-check && npm run build && npm run test-build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rqlite/rqlite-js.git"
  },
  "keywords": [
    "rqlite",
    "client",
    "nodejs"
  ],
  "author": "Justin Morant",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rqlite/rqlite-js/issues"
  },
  "homepage": "https://github.com/rqlite/rqlite-js#readme",
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.13",
    "@babel/eslint-parser": "^7.29.13",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/register": "^7.29.13",
    "@babel/runtime": "^7.29.13",
    "@types/node": "^22.20.5",
    "babel-plugin-add-module-exports": "^1.0.4",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-mocha": "^10.5.0",
    "mocha": "^12.0.3",
    "nock": "^13.5.6",
    "retry-as-promised": "^7.1.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "qs": "^6.17.1"
  }
}
