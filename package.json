{
  "name": "rqlite-js",
  "version": "3.0.2",
  "description": "A client library for RQLite written in TypeScript that works in NodeJS or the browser.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.integration.test.ts",
    "!src/test/**",
    "docs/MIGRATION-v2-to-v3.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "build-all": "tsdown",
    "build-clean": "rm -rf dist",
    "build-release": "npm run build && npm run test-build",
    "docker-build": "docker compose -p rqlitejs build",
    "docker-down": "docker compose -p rqlitejs down",
    "docker-logs": "docker compose -p rqlitejs logs",
    "docker-run-test": "docker compose -p rqlitejs run --rm test",
    "docker-stop": "docker compose -p rqlitejs stop",
    "cluster:up": "./bin/rqlite-cluster.sh up",
    "cluster:wait": "./bin/rqlite-cluster.sh wait",
    "cluster:status": "./bin/rqlite-cluster.sh status",
    "cluster:logs": "./bin/rqlite-cluster.sh logs",
    "cluster:down": "./bin/rqlite-cluster.sh down",
    "cluster:destroy": "./bin/rqlite-cluster.sh destroy",
    "cluster:restart": "./bin/rqlite-cluster.sh restart",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run lint && npm run type-check && npm test && npm run build && npm run test-build && npm run check-pack",
    "verify:integrations": "./bin/rqlite-cluster.sh test",
    "release": "npm run verify",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --testPathIgnorePatterns=integration",
    "test-integrations": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --testPathPatterns=integration --runInBand --testTimeout=30000",
    "test-build": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --testPathIgnorePatterns=integration",
    "test-build-integrations": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --testPathPatterns=integration --runInBand --testTimeout=30000",
    "check-pack": "npm pack --dry-run && publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run lint && npm run type-check && npm run build && npm run test-build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rqlite/rqlite-js.git"
  },
  "keywords": [
    "rqlite",
    "client",
    "nodejs",
    "typescript"
  ],
  "author": "Justin Morant",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rqlite/rqlite-js/issues"
  },
  "homepage": "https://github.com/rqlite/rqlite-js#readme",
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.14.0",
    "jest": "^30.2.0",
    "nock": "^14.0.10",
    "publint": "^0.3.14",
    "tsdown": "^0.15.12",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@swc/core@1.16.22": true
  }
}
